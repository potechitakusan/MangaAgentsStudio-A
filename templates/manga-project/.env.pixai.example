# PixAI用の記入例。作品ルートの .env.pixai へ写して使う（このファイル自体は読み込まない）。
# APIキー・URLは共通設定の .env（または .secrets/pixai.env・環境変数）に置き、このファイルには書かない。
# pixai_batch.py は環境変数と .env.pixai の変数を読む。同じ名前が両方にあればエラー。

# キャラクター・絵柄・背景・LoRAのプロンプト変数（依頼があった場合だけ使う）。要求JSONから ${変数名} で参照する。
# PIXAI_LORA_ の値はLoRAのバージョンID（https://pixai.art/model/<モデルID>/<バージョンID> の最後の数字）。
# 編集と再生成の手順: docs/pixai-prompts/README.md
# PIXAI_CHAR_MIO="1girl, light brown short bob hair, yellow hairclip, yellow hoodie over navy blazer"
# PIXAI_STYLE_MAIN="clean lineart, soft colors"
# PIXAI_BACKGROUND_CLASSROOM="classroom, desks, windows, daylight"
# PIXAI_LORA_MIO="1234567890123456789"

# pixai_compose.py（要求JSONの標準の組み立て）と pixai_batch.py が読む補助設定。上記の変数以外では、この5つだけ読む。
# 優先は 引数 > 環境変数・.env.pixai > 既定。
# PIXAI_MODEL="tsubaki2"   # tsubaki3・haruka2・hoshino2 またはバージョンID
# PIXAI_QUALITY_TAGS="masterpiece, best quality"
# PIXAI_NEGATIVE_PROMPT="text, speech bubble, panel border, watermark"   # 未設定でもこの４語が既定。空にすると付けない
# PIXAI_PROMPT_HELPER="disable"
# PIXAI_CHECK_IDENTITY=1
