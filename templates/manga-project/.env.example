# 記入例。実値は作品内の .secrets/novelai.env または環境変数へ設定する。
# ファイル内にも設定名が必要: NOVELAI_API_KEY=実際のトークン
# 左辺のNOVELAI_API_KEYは公開してよい設定名。秘密にするのは右辺のトークン。
# novelai_api.py の読込順: 環境変数 → .secrets/novelai.env → .secrets/.env → .env
# Persistent API tokenだけを指定する。Bearer接頭辞、メールアドレス、パスワードは不要。
# .env.example 自体は読み込まない。キーの実値をここへ書き込まない。
NOVELAI_API_KEY=
# キャラ別プロンプトの変数（依頼があった場合だけ使う）。要求JSONから ${NOVELAI_CHAR_MIO} のように参照する。
# novelai_batch.py が .env → .secrets/novelai.env → .secrets/.env から NOVELAI_CHAR_ で始まる変数だけを読む。
# NOVELAI_CHAR_MIO="1girl, light brown short bob hair, yellow hairclip, yellow hoodie over navy blazer"
# 以下のComfyUI項目は記入例であり、novelai_api.pyの読込対象ではない。
COMFYUI_URL=http://127.0.0.1:8188
COMFYUI_ROOT=
