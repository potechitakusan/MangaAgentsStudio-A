.vscode/
.idea/
.venv/
venv/
node_modules/
.cache/
.pytest_cache/
.mypy_cache/
.ruff_cache/
__pycache__/
*.py[cod]
*.log
*.tmp
*.temp
*.bak
*.bak.*
*.backup
*.backup.*
*.old
*.old.*
*.orig
*.swp
*.swo
*~

# 秘密設定。公開する環境変数の記入例は作品雛形だけに限定する。
.secrets/
.env
.env.*
!/templates/manga-project/.env.example
credentials.json
secrets.json
*.local.json

